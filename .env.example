# AWS Configuration
AWS_ACCOUNT_ID=your_12_digit_account_id
DEFAULT_AWS_REGION=us-east-1

# Project Configuration
PROJECT_NAME=twin

# ── Cost & Bot Protection ──────────────────────────────────────────────────────
# DynamoDB table name for daily cost tracking (injected by Terraform automatically)
COST_TABLE=twin-dev-cost-tracker

# Hard daily cost limit in USD — API returns 503 when exceeded
DAILY_BUDGET_USD=5.0

# Per-session limits (bot protection)
MAX_MESSAGES_PER_SESSION=30
MAX_TOKENS_PER_SESSION=50000